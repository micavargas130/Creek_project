# Copiar como .env y completar (nunca subir el .env al repo)
MONGO=mongodb+srv://<usuario>:<password>@<cluster>/<base>
MONGO_TEST=mongodb+srv://<usuario>:<password>@<cluster>/<base-de-pruebas>
JWT_KEY=<string-largo-y-aleatorio>
PORT=4000

# Gmail desde el que se mandan los mails de reservas (usar una "contraseña de aplicación" de Google)
EMAIL_USER=arroyitocamping@gmail.com
EMAIL_PASS=<contraseña-de-aplicacion>

# Opcional: client id de Google OAuth (por defecto usa el mismo que el frontend)
# GOOGLE_CLIENT_ID=
